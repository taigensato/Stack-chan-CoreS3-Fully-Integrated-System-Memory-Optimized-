// ==========================================
// --- AquesTalk Pico 音声出力 ---
// ==========================================
void speakKoe(const char* koe) {
  if (M5.Speaker.isPlaying()) {
    M5.Speaker.stop();
  }

  // 話速: 90
  uint8_t err = CAqTkPicoF_SetKoe((const uint8_t*)koe, 90, 0xffffU);
  if (err != 0) {
    Serial.printf("[エラー] CAqTkPicoF_SetKoe 失敗: %d\n", err);
    return;
  }

  short rawFrame[FRAME_LEN];
  uint16_t outLen = 0;
  int frameCount = 0;

  while (true) {
    uint8_t res = CAqTkPicoF_SyntheFrame(rawFrame, &outLen);
    if (outLen > 0) {
      avatar.setMouthOpenRatio((frameCount++ % 2 == 0) ? 0.7f : 0.2f);
      
      while (M5.Speaker.isPlaying(1) >= 2) {
        vTaskDelay(pdMS_TO_TICKS(2));
      }
      M5.Speaker.playRaw(rawFrame, outLen, 8000, false, 1, 1);
    } else {
      vTaskDelay(pdMS_TO_TICKS(1));
    }
    if (res != 0) break;
  }
  avatar.setMouthOpenRatio(0.0f);
} 
void speakAquesTalk(const char* romajiText) {
  printSerial("[AquesTalk Target]: ", romajiText);

  clearUARTBuffer();
  speakKoe(romajiText); 
  ignoreAsrUntil = millis() + 1000;
  clearUARTBuffer();
}


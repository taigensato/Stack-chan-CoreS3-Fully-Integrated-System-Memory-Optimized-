// ==========================================
// --- ASR バイナリパケット解析器 ---
// フォーマット: [0xAA] [0x55] [ID] [0x55] [0xAA]
// ==========================================
bool readASRPacket(int &outCmdId) {
  static uint8_t pktBuf[5];

  while (SerialPortC.available() > 0) {
    uint8_t b = SerialPortC.read();
    // ★★★ここを追加：受信した生のデータを16進数でシリアルモニタに出力★★★
    Serial.printf("[%02X] ", b);

    if (asrPktIdx == 0) { 
      if (b == 0xAA) {
        pktBuf[0] = b;
        asrPktIdx = 1; 
      }
      continue;
    }

    if (asrPktIdx == 1) { 
      if (b == 0x55) {
        pktBuf[1] = b;
        asrPktIdx = 2; 
      } else if (b == 0xAA) {
        asrPktIdx = 1; 
      } else {
        asrPktIdx = 0; 
      }
      continue;
    }

    if (asrPktIdx == 2) { 
      pktBuf[2] = b;
      asrPktIdx = 3; 
      continue;
    }

    if (asrPktIdx == 3) { 
      if (b == 0x55) {
        pktBuf[3] = b;
        asrPktIdx = 4; 
      } else {
        asrPktIdx = 0; 
      }
      continue;
    }

    if (asrPktIdx == 4) { 
      if (b == 0xAA) {
        pktBuf[4] = b;
        outCmdId = pktBuf[2]; 
        asrPktIdx = 0;        
        return true;          
      } else {
        asrPktIdx = 0; 
      }
    }
  }

  return false; 
}

// ==========================================
// --- Setup & Loop ---
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(3000); // ★追加：PCがUSB（COMポート）を認識し、シリアルモニタが開くのを待つ
  // Wi-Fi機能を明示的に完全停止（RFノイズと電源リップルの抑制）
  WiFi.mode(WIFI_OFF);
  btStop(); // ★Bluetoothを完全停止

  auto cfg = M5.config();
  
  cfg.internal_spk = true;
  cfg.internal_mic = true;

  auto spk_cfg = M5.Speaker.config();
  spk_cfg.sample_rate = 44100;
  spk_cfg.task_priority = 3;
  M5.Speaker.config(spk_cfg);
  // --- ここを追加：USBシリアルがPCに認識されるのを待つ ---

  M5.begin(cfg);
  M5.Speaker.begin();
  M5.Speaker.setVolume(currentVolume);

  M5.Imu.begin();
  SerialPortC.begin(115200, SERIAL_8N1, PORT_C_RX, PORT_C_TX);

  if (!SD.begin(GPIO_NUM_4, SPI, 15000000)) { 
    Serial.println("SD Card Mount Failed");
  } 

  initServos();
  avatar.init();
  scanSDCard();

  uint8_t res = CAqTkPicoF_Init(picoWorkBuf, FRAME_LEN, NULL);
  if (res != 0) {
    Serial.printf("[エラー] CAqTkPicoF_Init 失敗: %d\n", res);
  } else {
    Serial.println("[OK] AquesTalk Pico 初期化成功");
  }

  xTaskCreatePinnedToCore(audioTask, "audioTask", 8192, NULL, 2, NULL, 0);
  xTaskCreatePinnedToCore(servoAvatarTask, "servoAvatarTask", 4096, NULL, 0, NULL, 1);

  nextRandomActionTime = millis() + random(8000, 12000);

  // ★修正箇所：発話とモーションが【終わった後】にタイマーをセットする
  avatar.setSpeechText("Hello!");
  speakAquesTalk("ko'nnichiwa");
  performBow();
  speechTextTimeout = millis() + 2000;
}

void loop() {
  M5.update();

  int receivedCmdId = -1;
  if (readASRPacket(receivedCmdId)) {
    if (currentRobotMode != MODE_IDLE || currentConvState == CONV_TALK || millis() < ignoreAsrUntil) {
      clearUARTBuffer();
    } else {
      handleASRInput(receivedCmdId);
    }
  }

  checkConversationTimeout();

  if (speechTextTimeout > 0 && millis() > speechTextTimeout) {
    avatar.setSpeechText("");
    speechTextTimeout = 0;
  }

  if (requestPlayNext) {
    requestPlayNext = false;
    if (currentRobotMode == MODE_PLAYBACK) {
      playRandomMusic();
    }
  }

  if (M5.Touch.getCount() > 0) {
    auto detail = M5.Touch.getDetail(0);
    
    if (detail.wasPressed()) {
      int x = detail.x;
      int y = detail.y;

      if (y < 120) {
        if (x < 160) {
          currentVolume = (uint8_t)max(0, currentVolume - 25);
          avatar.setSpeechText("vol down");
        } else {
          currentVolume = (uint8_t)min(255, currentVolume + 25);
          avatar.setSpeechText("vol up");
        }
        M5.Speaker.setVolume(currentVolume);
        M5.Speaker.setAllChannelVolume(currentVolume);
        speechTextTimeout = millis() + 1500;
      } 
      else {
        if (x < 106) {
          if (currentRobotMode != MODE_PLAYBACK) {
            currentRobotMode = MODE_PLAYBACK;
            currentConvState = CONV_LISTEN_WAIT;
            avatar.setSpeechText("Play Music");
            playRandomMusic();
            speechTextTimeout = millis() + 2000; // ★修正
          }
        } 
        else if (x >= 106 && x < 213) {
          if (currentRobotMode == MODE_PLAYBACK) stopMusic();
          avatar.setSpeechText("stop");
          clearUARTBuffer();
          
          currentRobotMode = MODE_IDLE;
          currentConvState = CONV_LISTEN_WAIT;
          
          performBow();
          
          speechTextTimeout = millis() + 2000; // ★修正
          nextRandomActionTime = millis() + random(8000, 15000);
          clearUARTBuffer();
        } 
        else {
          if (currentRobotMode == MODE_PLAYBACK) stopMusic();
          avatar.setSpeechText("Idle Mode");
          clearUARTBuffer();
          
          currentRobotMode = MODE_IDLE;
          currentConvState = CONV_LISTEN_WAIT;
          
          performBow();
          
          speechTextTimeout = millis() + 2000; // ★修正
          nextRandomActionTime = millis() + random(8000, 15000);
          clearUARTBuffer();
        }
      }
    }
  }

  if (currentRobotMode == MODE_IDLE) {
    checkIMU();
    if (currentConvState != CONV_TALK) {
      checkRandomIdleAction();
    }
  }

  vTaskDelay(pdMS_TO_TICKS(1));
}

// ==========================================
// --- ASR ＆ 会話処理 ---
// ==========================================
void handleASRInput(int cmdId) {
  const IntegratedAsrCommand* cmd = getAsrCommand(cmdId);
  if (cmd == nullptr) return;
  if (currentRobotMode != MODE_IDLE) return;

  printSerial("[ASR Cmd Received]: ", cmd->raw_jp);

  if (cmdId == 0 || cmdId== 99) {
    currentConvState = CONV_LISTEN_ACTIVE;
    lastVoiceInputTime = millis();
    avatar.setSpeechText("((( ACTIVE )))");
    speakAquesTalk("ko'nnichiwa");
    
    // ★修正箇所：発話完了後にタイマーをセット
    speechTextTimeout = millis() + 2000; 
    lastVoiceInputTime = millis();
    return;
  }

  lastVoiceInputTime = millis();
  currentConvState = CONV_TALK;

  char displayRes[256];
  char romajiRes[256];
  
  analyze(cmd, displayRes, romajiRes, sizeof(displayRes));

  printSerial("[ELIZA Display]: ", displayRes);
  speakAquesTalk(romajiRes);

  lastVoiceInputTime = millis();

  if ((cmdId >= 37 && cmdId <= 42) || strstr(cmd->raw_jp, "終了") != NULL || strstr(cmd->raw_jp, "さようなら") != NULL || strstr(cmd->raw_jp, "バイバイ") != NULL) {
    currentConvState = CONV_LISTEN_WAIT;
    avatar.setSpeechText("Idle Mode");
    speechTextTimeout = millis() + 2000;
    nextRandomActionTime = millis() + random(8000, 15000);
    clearUARTBuffer();
  } else {
    currentConvState = CONV_LISTEN_ACTIVE;
  }
}

void checkConversationTimeout() {
  if (currentRobotMode == MODE_IDLE && currentConvState == CONV_LISTEN_ACTIVE) {
    if (millis() - lastVoiceInputTime > SILENCE_TIMEOUT) {
      currentConvState = CONV_LISTEN_WAIT;
      avatar.setSpeechText("Idle Mode");
      speechTextTimeout = millis() + 2000;
      nextRandomActionTime = millis() + random(8000, 15000);
      clearUARTBuffer();
      printSerial("[ELIZA]: ", "10s Timeout -> Returned to CONV_LISTEN_WAIT (Buffer Cleared)");
    }
  }
}

// ==========================================
// --- モーション ＆ アイドル動作 ---
// ==========================================
void checkRandomIdleAction() {
  if (millis() > nextRandomActionTime) {
    int act = random(0, 2);
    if (act == 0) performBow();
    else performLookAround();
    nextRandomActionTime = millis() + random(8000, 16000);
  }
}

void performBow() {
  RobotMode previousMode = currentRobotMode;
  currentRobotMode = MODE_ACTION; 

  clearUARTBuffer();

  setServoDuty(PIN_SERVO_PAN, PAN_CENTER);
  for (int duty = TILT_CENTER; duty >= TILT_MIN; duty--) {
    setServoDuty(PIN_SERVO_TILT, duty);
    vTaskDelay(pdMS_TO_TICKS(30));
  }

  vTaskDelay(pdMS_TO_TICKS(300));

  for (int duty = TILT_MIN; duty <= TILT_CENTER; duty++) {
    setServoDuty(PIN_SERVO_TILT, duty);
    vTaskDelay(pdMS_TO_TICKS(25));
  }

  clearUARTBuffer();
  currentRobotMode = previousMode; 
}

void performLookAround() {
  RobotMode previousMode = currentRobotMode;
  currentRobotMode = MODE_ACTION;

  clearUARTBuffer();

  for (int duty = PAN_CENTER; duty <= PAN_MAX - 10; duty++) {
    setServoDuty(PIN_SERVO_PAN, duty);
    vTaskDelay(pdMS_TO_TICKS(15));
  }
  vTaskDelay(pdMS_TO_TICKS(200));

  for (int duty = PAN_MAX - 10; duty >= PAN_MIN + 10; duty--) {
    setServoDuty(PIN_SERVO_PAN, duty);
    vTaskDelay(pdMS_TO_TICKS(15));
  }
  vTaskDelay(pdMS_TO_TICKS(200));

  for (int duty = PAN_MIN + 10; duty <= PAN_CENTER; duty++) {
    setServoDuty(PIN_SERVO_PAN, duty);
    vTaskDelay(pdMS_TO_TICKS(15));
  }

  clearUARTBuffer();
  currentRobotMode = previousMode;
}

// ==========================================
// --- サーボ制御 ---
// ==========================================
void initServos() {
  ledcAttach(PIN_SERVO_PAN, 50, 10); 
  ledcAttach(PIN_SERVO_TILT, 50, 10);

  lastDutyPan = -1;
  lastDutyTilt = -1;
  setServoDuty(PIN_SERVO_PAN, PAN_CENTER);
  setServoDuty(PIN_SERVO_TILT, TILT_CENTER);
}

void setServoDuty(int pin, int duty) {
  if (currentRobotMode == MODE_PLAYBACK) return;

  if (pin == PIN_SERVO_PAN) {
    if (duty < PAN_MIN) duty = PAN_MIN;
    if (duty > PAN_MAX) duty = PAN_MAX;
  } else if (pin == PIN_SERVO_TILT) {
    if (duty < TILT_MIN) duty = TILT_MIN;
    if (duty > TILT_MAX) duty = TILT_MAX;
  }

  if (pin == PIN_SERVO_PAN) {
    if (duty != lastDutyPan) {
      ledcAttach(pin, 50, 10);
      ledcWrite(pin, duty);
      lastDutyPan = duty;
    }
  } else if (pin == PIN_SERVO_TILT) {
    if (duty != lastDutyTilt) {
      ledcAttach(pin, 50, 10);
      ledcWrite(pin, duty);
      lastDutyTilt = duty;
    }
  }
}

void disableServos() {
  ledcDetach(PIN_SERVO_PAN);
  ledcDetach(PIN_SERVO_TILT);
  lastDutyPan = -1;
  lastDutyTilt = -1;
}

// ==========================================
// --- 音楽再生 & SDカード機能 ---
// ==========================================
void playBeep(int freq, int duration) {
  if (!ENABLE_BEEP_SOUND) return;

  M5.Speaker.setVolume(currentVolume);
  M5.Speaker.tone(freq, duration);
  vTaskDelay(pdMS_TO_TICKS(duration + 20));
}

void scanSDCard() {
  musicFiles.clear();
  File root = SD.open("/");
  if (!root) return;

  File file = root.openNextFile();
  while (file) {
    if (!file.isDirectory()) {
      String name = String(file.name());
      if (name.endsWith(".mp3") || name.endsWith(".MP3") || name.endsWith(".wav") || name.endsWith(".WAV")) {
        musicFiles.push_back("/" + name);
      }
    }
    file = root.openNextFile();
  }
  root.close();
}

void playRandomMusic() {
  if (musicFiles.empty()) {
    playBeep(2000, 100); 
    avatar.setSpeechText("No music. Sorry");
    speechTextTimeout = millis() + 2000;
    currentRobotMode = MODE_IDLE;
    return;
  }

  stopMusic();

  int index = random(0, musicFiles.size());
  String targetFile = musicFiles[index];

  M5.Speaker.setVolume(currentVolume);
  M5.Speaker.setAllChannelVolume(currentVolume);

  audioFile = new AudioFileSourceSD(targetFile.c_str());
  audioOut  = new AudioOutputM5Speaker(&M5.Speaker, 0);

  if (targetFile.endsWith(".wav") || targetFile.endsWith(".WAV")) {
    audioGen = new AudioGeneratorWAV();
  } else {
    audioGen = new AudioGeneratorMP3();
  }

  if (audioGen->begin(audioFile, audioOut)) {
    isPlaying = true;
    currentRobotMode = MODE_PLAYBACK;
    disableServos();
    clearUARTBuffer();
    Serial.println("Audio Playing: " + targetFile);
  } else {
    Serial.println("Error: Failed to play Audio");
    avatar.setSpeechText("Play Error");
    speechTextTimeout = millis() + 2000;
    stopMusic();
  }
}

void stopMusic() {
  isPlaying = false;

  if (audioGen) {
    audioGen->stop();
    delete audioGen;
    audioGen = nullptr;
  }
  if (audioFile) {
    delete audioFile;
    audioFile = nullptr;
  }
  if (audioOut) {
    delete audioOut;
    audioOut = nullptr;
  }
}

void checkIMU() {
  if (!M5.Imu.isEnabled()) return;

  static uint32_t lastCheck = 0;
  if (millis() - lastCheck < 200) return;
  lastCheck = millis();

  float ax, ay, az;
  M5.Imu.getAccel(&ax, &ay, &az);

  float totalAccel = sqrt(ax*ax + ay*ay + az*az);
  if (totalAccel > 1.5) { 
    if (ENABLE_BEEP_SOUND) {
      playBeep(1500, 150);
    } 
    avatar.setSpeechText("Hello!");
    performBow();
    speechTextTimeout = millis() + 2000; // ★修正
    nextRandomActionTime = millis() + random(8000, 16000);
  }
}

// ==========================================
// --- FreeRTOS タスク ---
// ==========================================
void audioTask(void *pvParameters) {
  while (1) {
    if (isPlaying && audioGen && audioGen->isRunning()) {
      if (!audioGen->loop()) {
        stopMusic();
        requestPlayNext = true;
      }
      vTaskDelay(pdMS_TO_TICKS(1));
    } else {
      vTaskDelay(pdMS_TO_TICKS(10));
    }
  }
}

void servoAvatarTask(void *pvParameters) {
  int motionTick = 0;
  TickType_t xLastWakeTime = xTaskGetTickCount();

  while (1) {
    motionTick++;

    if (currentRobotMode == MODE_PLAYBACK) {
      avatar.setMouthOpenRatio(0.0); 
    } 
    else if (currentRobotMode == MODE_IDLE) {
      if (currentConvState != CONV_TALK) {
        if (motionTick % 10 == 0) {
          if (random(0, 10) > 4) {
            idleMouthRatio = (float)random(20, 80) / 100.0f;
          } else {
            idleMouthRatio = 0.0f;
          }
        }
        avatar.setMouthOpenRatio(idleMouthRatio);
      }

      if (currentConvState == CONV_TALK) {
        setServoDuty(PIN_SERVO_PAN, PAN_CENTER);
        setServoDuty(PIN_SERVO_TILT, TILT_CENTER);
      } else {
        int targetPan  = PAN_CENTER + (int)(15.0 * sin(motionTick * 0.05));
        setServoDuty(PIN_SERVO_PAN, targetPan);
        setServoDuty(PIN_SERVO_TILT, TILT_CENTER);
      }
    }
    
    vTaskDelayUntil(&xLastWakeTime, pdMS_TO_TICKS(33));
  }
}

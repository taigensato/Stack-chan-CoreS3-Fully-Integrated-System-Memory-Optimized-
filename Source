// --- M5Unifiedスピーカー用 高音質・プチプチノイズ防止出力クラス ---
// =================================================================
class AudioOutputM5Speaker : public AudioOutput {
  private:
    m5::Speaker_Class* _m5sound;
    uint8_t _ch;
    static const size_t BUF_SIZE = 256;
    int16_t _buffer[BUF_SIZE]; 
    size_t _bufIdx = 0;
    int32_t _prevMono = 0;

  public:
    AudioOutputM5Speaker(m5::Speaker_Class* m5sound, uint8_t channel = 0) {
      _m5sound = m5sound;
      _ch = channel;
    }

    virtual bool begin() override { 
      _bufIdx = 0;
      _prevMono = 0;
      return true; 
    }
    
    virtual bool ConsumeSample(int16_t sample[2]) override {
      int32_t outL = (int32_t)(sample[0] * 0.35f);
      int32_t outR = (int32_t)(sample[1] * 0.35f);

      int32_t mono = (outL + outR) / 2;
      mono = (mono * 65 + _prevMono * 35) / 100;
      _prevMono = mono;

      if (mono > 32767)  mono = 32767;
      if (mono < -32768) mono = -32768;

      _buffer[_bufIdx++] = (int16_t)mono;

      if (_bufIdx >= BUF_SIZE) {
        uint32_t hz = (this->hertz > 0) ? this->hertz : 44100;
        while (_m5sound->isPlaying(_ch) >= 2) {
          esp_rom_delay_us(100);
        }
        _m5sound->playRaw(_buffer, _bufIdx, hz, false, 1, _ch);
        _bufIdx = 0;
      }
      return true; 
    }

    virtual bool stop() override { 
      if (_bufIdx > 0) {
        uint32_t hz = (this->hertz > 0) ? this->hertz : 44100;
        _m5sound->playRaw(_buffer, _bufIdx, hz, false, 1, _ch);
        _bufIdx = 0;
      }
      _m5sound->stop(_ch);
      return true; 
    }
};

